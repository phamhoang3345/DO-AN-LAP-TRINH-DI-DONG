<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Logo hình người (Avatar) -->
        <androidx.cardview.widget.CardView
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#E0F2F1"
            app:cardCornerRadius="44dp"
            app:cardElevation="2dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="👤"
                android:textSize="40sp" />
        </androidx.cardview.widget.CardView>

        <!-- Tên người dùng -->
        <TextView
            android:id="@+id/tv_user_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nguyen Ngan Giang"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Email hoặc thông tin phụ -->
        <TextView
            android:id="@+id/tv_user_email"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="24dp"
            android:text="giang.nguyen@example.com"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <!-- Danh sách tuỳ chọn cá nhân -->
        <TextView
            android:id="@+id/tv_option_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@color/card_background"
            android:padding="14dp"
            android:text="✏️ Chỉnh sửa hồ sơ"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tv_option_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@color/card_background"
            android:padding="14dp"
            android:text="🔒 Đổi mật khẩu"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <!-- Nút Xóa tất cả dữ liệu ứng dụng -->
        <TextView
            android:id="@+id/tv_option_clear_data"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@color/card_background"
            android:padding="14dp"
            android:text="🗑️ Xóa tất cả dữ liệu (Reset)"
            android:textColor="#D32F2F"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_option_logout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/card_background"
            android:padding="14dp"
            android:text="🚪 Đăng xuất"
            android:textColor="#C66A42"
            android:textSize="16sp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
