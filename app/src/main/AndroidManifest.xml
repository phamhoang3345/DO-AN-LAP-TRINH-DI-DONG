<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".ExpenseManagerApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_expense_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_expense_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.ExpenseManager">

        <!-- Màn hình chào (Splash Screen - Màn hình khởi chạy chính) -->
        <activity
            android:name=".ui.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.App.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Màn hình Đăng nhập -->
        <activity
            android:name=".ui.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Màn hình Đăng ký tài khoản -->
        <activity
            android:name=".ui.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- MNN hình Chính (Trang chủ) -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Màn hình Thêm khoản thu -->
        <activity
            android:name=".ui.AddIncomeActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Màn hình Thêm / Sửa khoản chi tiêu -->
        <activity
            android:name=".ui.AddExpenseActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Màn hình Chi tiết khoản chi -->
        <activity
            android:name=".ui.ExpenseDetailActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- MNN hình Quản lý danh mục -->
        <activity
            android:name=".ui.CategoryActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

    </application>

</manifest>
