<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F5F0"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Avatar tượng trưng -->
    <ImageView
        android:id="@+id/img_avatar"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="16dp"
        android:background="@android:drawable/ic_menu_myplaces"
        android:backgroundTint="#263B32"
        android:contentDescription="Avatar" />

    <!-- Tên người dùng -->
    <TextView
        android:id="@+id/tv_user_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nguyen Ngan Giang"
        android:textColor="#263B32"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Email hoặc thông tin phụ -->
    <TextView
        android:id="@+id/tv_user_email"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="24dp"
        android:text="giang.nguyen@example.com"
        android:textColor="#666666"
        android:textSize="14sp" />

    <!-- Danh sách tuỳ chọn cá nhân -->
    <TextView
        android:id="@+id/tv_option_settings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="#FFFFFF"
        android:padding="12dp"
        android:text="⚙️ Cài đặt tài khoản"
        android:textColor="#263B32"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/tv_option_password"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="#FFFFFF"
        android:padding="12dp"
        android:text="🔒 Đổi mật khẩu"
        android:textColor="#263B32"
        android:textSize="16sp" />

    <!-- Nút Xóa tất cả dữ liệu ứng dụng -->
    <TextView
        android:id="@+id/tv_option_clear_data"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="#FFFFFF"
        android:padding="12dp"
        android:text="🗑️ Xóa tất cả dữ liệu (Reset)"
        android:textColor="#D32F2F"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_option_logout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:padding="12dp"
        android:text="🚪 Đăng xuất"
        android:textColor="#C66A42"
        android:textSize="16sp" />

</LinearLayout>
