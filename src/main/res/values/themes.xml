<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.ExpenseManager" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">#F7F5F0</item>
    </style>

    <style name="Theme.ExpenseManager" parent="Base.Theme.ExpenseManager" />

    <!-- Theme cho Android 12+ System Splash Screen để đồng bộ Logo & màu nền -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#F7F5F0</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_expense_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.ExpenseManager</item>
    </style>
</resources>
